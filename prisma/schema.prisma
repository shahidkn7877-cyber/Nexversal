datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String            @id @default(cuid())
  email             String            @unique
  name              String?
  passwordHash      String
  role              String            @default("USER")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  sessions          Session[]
  settings          UserSettings?
  keywordResearches KeywordResearch[]

  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Audit {
  id             String   @id @default(cuid())
  url            String
  targetKeyword  String
  score          Int
  status         String
  passedCount    Int
  warningCount   Int
  criticalCount  Int
  checksJson     String
  pageDataJson   String?
  timestamp      DateTime @default(now())
  userId         String?

  @@index([userId])
  @@index([timestamp])
  @@map("audits")
}

model KeywordResearch {
  id          String                  @id @default(cuid())
  userId      String
  provider    String                  @default("google-ads")
  seedKeyword String?
  seedUrl     String?
  location    String                  @default("US")
  language    String                  @default("en")
  createdAt   DateTime                @default(now())

  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  results     KeywordResearchResult[]

  @@index([userId])
  @@index([createdAt])
  @@map("keyword_researches")
}

model KeywordResearchResult {
  id                     String          @id @default(cuid())
  researchId             String
  keyword                String
  averageMonthlySearches Int?
  competition            String?
  competitionIndex       Int?
  lowTopOfPageBid        Float?
  highTopOfPageBid       Float?
  currency               String?         @default("USD")
  createdAt              DateTime        @default(now())

  research               KeywordResearch @relation(fields: [researchId], references: [id], onDelete: Cascade)

  @@index([researchId])
  @@index([keyword])
  @@map("keyword_research_results")
}

model Activity {
  id           String   @id @default(cuid())
  type         String
  userId       String
  summary      String
  metadataJson String?
  timestamp    DateTime @default(now())

  @@index([userId])
  @@index([timestamp])
  @@index([type])
  @@map("activities")
}

model UserSettings {
  id              String   @id @default(cuid())
  userId          String   @unique
  editorDialect   String   @default("en-US")
  targetWordCount String   @default("1,500")
  defaultDevice   String   @default("desktop")
  autoSlug        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}