# Nexversal Environment Variables Template

# Production Database (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://user:password@host:5432/postgres?sslmode=require"

# Admin Authentication & Gateways
ADMIN_SECRET_KEY="seo_admin_vault_secret_2026"
ADMIN_EMAIL="admin@optemizer.com"
ADMIN_PASSWORD="your_secure_admin_password"

# Public Application URL
NEXT_PUBLIC_APP_URL="https://nexversal.bond"

# ==============================================================================
# AI Provider Configuration (Configure at least one for live AI capabilities)
# All keys remain strictly server-side and are NEVER exposed to the browser.
# ==============================================================================

# 1. Groq Cloud (Recommended: Ultra-fast Llama 3.3 70B inference)
# Obtain key at: https://console.groq.com/keys
GROQ_API_KEY="gsk_..."
GROQ_MODEL="llama-3.3-70b-versatile"

# 2. Ollama (Local or Self-Hosted inference)
# Set to http://localhost:11434 for local, or your remote host URL (NOT https://ollama.com)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"
# OLLAMA_API_KEY="" # Optional if self-hosted with authorization gateway

# 3. Google Gemini
# Obtain key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# 4. OpenAI ChatGPT
# Obtain key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# 5. Anthropic Claude
# Obtain key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# 6. DeepSeek
# Obtain key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"
